# Define activation functions and their first derivatives. 
# Define the objective g and its first derivative w.r.t. the final layer of activation.
sig1 = function(z)
{
   tanh(z)  
}
sig1. = function(z)
{
   1-tanh(z)^2
}
sig2 = function(z)
{
   1/(1+exp(-z))
}
sig2. = function(z)
{
   sig2(z)*(1-sig2(z))
}
g     = function(yhat,y)  ## Ci-s
{
     -(y*log(yhat)+(1-y)*log(1-yhat))	    
}
g.     = function(yhat,y)
{
	   -(y/yhat-(1-y)/(1-yhat))
}
neural_net = function(X,Y,theta,m,nu=0)
{

   N = dim(X)[1]
   p = dim(X)[2]
   q = dim(Y)[2]

   index = 1:(p*m)
   W1    = matrix(theta[index],p,m)
   index = max(index)+1:(m*q)
   W2    = matrix(theta[index],m,q)
   index = max(index)+1:(m)
   b1    = matrix(theta[index],m,1)
   index = max(index)+1:(q)
   b2    = matrix(theta[index],q,1)
   

   out   = rep(0,N)
   error = rep(0,N)
   # Define storage for gradient matrices and vectors 

   ones = matrix(1,N,1)

    A0  = t(X)
    Z1  = t(W1)%*%A0+b1%*%t(ones)
    A1  = sig1(Z1)
    Z2  = t(W2)%*%A1+b2%*%t(ones)
    A2  = sig2(Z2)

    Y_hat = t(A2)
    
    # Evaluate the working gradients:
    D2 = g.(A2,t(Y))*sig2.(Z2) # Step A
    D1 = (W2%*%D2)*sig1.(Z1)   # Step B
    	
    # Evaluate gradient matrices and vectors:
    db1 = D1%*%ones            # Step C (Biases)
    db2 = D2%*%ones
    
    dW1 = A0%*%t(D1) +nu*2*W1           # Step C (Weights)
    dW2 = A1%*%t(D2) +nu*2*W2          # Step C (Weights)
    
    # Evaluate error function:
    error =  g(A2,t(Y)) # Ci s 
   #}
   E1    = sum(error)  # Ctot
   E2    = E1+nu*(sum(W1^2)+sum(W2^2))

   return(list(grad = c(dW1,dW2,db1,db2)/N,Y_hat = Y_hat, E1 = E1/N, E2 = E2/N))
}


