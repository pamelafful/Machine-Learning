# Write a function that applies the gradient descent procedure for your 
# Neural network 
grad_dec = function(theta_start,h = 1/100, iterations = 1000)
{
   # Initialise:
	 theta     = theta_start
	 errors    = rep(NA,iterations) 
	 
	 N         = dim(X)[1]
	 set       = sample(1:N,1*N,replace = FALSE)
	 res       = neural_net(X[set,,drop=FALSE],Y[set,,drop=FALSE],theta,m,nu)
	 errors[1] = res$E2 
	 
   # Iterate:
	 for(i in 2:iterations)
	 {
	    # Apply updating equation:
	 	  theta     = theta-h*res$grad
	    set       = sample(1:N,1*N,replace = FALSE)
	    res       = neural_net(X[set,,drop=FALSE],Y[set,,drop=FALSE],theta,m,nu)
	    errors[i] = res$E2 
	    
	 	  if(i%%250==0)
	 	  {
	 	  	print(paste0('Iteration = ', i))
	 	  	
	 	  	par(mfrow = c(2,2))
	 	  	plot(errors,type = 's',col = 'blue', main = paste0('Iteration ',i))
	 	  	plot(theta,type = 'h',lwd = 2, main = 'Parameters', ylim = c(-3,3))
	 	  	plot(res$grad,type = 'h',lwd = 2, main = 'Gradients',ylim = c(-1,1)*0.01)
	 	  	abline(h = c(-1,1)*0.01 , lty =2)
	 	  	res_fitted = neural_net(XX,YY,theta,m,nu)
        plot(XX[,2]~XX[,1],col = color.gradient(res_fitted$Y_hat),pch = 16,cex = 0.5)
	 	  	Sys.sleep(0.05)
	 	 }
	 }
	 ret = list(errors = errors, theta_hat = theta)
	 return(ret)
}


