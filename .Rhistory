a   = res$alpha[my_sv_coeff]
plot(x2~x1,pch = c(1,16)[(y+1)/2+1],main='Manual QP SVM Solution')
points(x2[my_sv_coeff]~x1[my_sv_coeff], pch = 1,col = 'darkred',cex=2)
text(x = 10, y = 10, labels = paste("#SV:",my_mod_sv), col = "darkblue", cex = 1, font = )
# SVM SVs
plot(x2~x1,pch = c(1,16)[(y+1)/2+1], main='SVM Package Solution')
