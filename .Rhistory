#| label: fig-subplots
#| fig-cap: "f(x) two ways"
#| fig-subcap:
#|   - "Bias vs Noise (sigma)"
#|   - "Variance vs Noise (sigma)"
#|   - "E[OOS Error] vs Noise (sigma)"
#| layout-ncol: 3
set.seed(321)
sigmas=seq(0,0.5,0.1)
f_true=f_x
N=5
# apply function for all sigmas
h1_sigma_function_values=sapply(sigmas,oos_estimate,f_true=f_x,hyp=h1,N=5,nsim=1000)
h2_sigma_function_values=sapply(sigmas,oos_estimate,f_true=f_x,hyp=h2,N=5,nsim=1000)
par(mfrow = c(1,3 ))
# create bias plot
plot(NULL,xlim=c(0,0.5),ylim=c(0,0.10),xlab='sigma',ylab='bias2',main=' Model Bias vs Noise Parameter (sigma)',)
