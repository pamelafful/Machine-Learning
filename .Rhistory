points(sigmas,unlist(h2_sigma_function_values[2,]),col='red',pch = 1)
h1_oos_variance_mean=round(mean(unlist(h1_sigma_function_values[2,])),2)
h2_oos_variance_mean=round(mean(unlist(h2_sigma_function_values[2,])),2)
text3=paste('h1(x) Avg Var:',h1_oos_variance_mean)
text4=paste('h2(x) Avg Var:',h2_oos_variance_mean)
plot_text=paste(text3,text4,sep = "\n")
text(x =0.08, y = 0.15, labels =plot_text ,
srt = 0, adj = c(0.5, -0.5), col = "blue",cex=0.75)
legend("bottomright",
legend = c("h1(x)", "h2(x)"), # Text labels
col = c('blue','red'),
pch = 1,
cex=0.85,
title = "Hypothesis",
bty='n')
plot(NULL,xlim=c(0,0.5),ylim=c(0.07,0.22),xlab='sigma',ylab='E[E_OOS_Err]',main=' Model Expected OOS Error vs Noise Parameter (sigma)',)
